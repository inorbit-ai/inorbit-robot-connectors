# Gausium Open Platform Connection
# All values prefixed with INORBIT_GAUSIUM_OPEN_PLATFORM_ will be used as defaults for
# connector_config setting values
INORBIT_GAUSIUM_OPEN_PLATFORM_CLIENT_ID=your-client-id
INORBIT_GAUSIUM_OPEN_PLATFORM_CLIENT_SECRET=your-client-secret
INORBIT_GAUSIUM_OPEN_PLATFORM_ACCESS_KEY_SECRET=your-access-key-secret

# InOrbit Connection
INORBIT_API_KEY=your-inorbit-api-key

# For local InOrbit instances, use:
# INORBIT_CONNECTION_CONFIG_URL=http://localdev.com:3000/cloud_sdk_robot_config
# INORBIT_API_URL=http://localdev.com:3000

# General Settings
# INORBIT_LOG_LEVEL=INFO
# INORBIT_LOCATION_TZ=America/Los_Angeles
